# Copy this file to .env and fill in values (DO NOT commit .env with secrets)

TELEGRAM_BOT_TOKEN=bot<your-telegram-bot-token>
GITHUB_TOKEN=<your-personal-access-token>
GITHUB_REPO=owner/repo
BRANCH=main
POLL_INTERVAL=5

# Optional: restrict who can use the bot (comma-separated usernames or numeric ids)
TELEGRAM_ALLOWED_USERS=@yourusername,123456789

# Optional TMS credentials (used by /holdings and other TMS commands)
TMS_BASE_URL=https://tms35.nepsetms.com.np
TMS_USERNAME=your_tms_client_code
TMS_PASSWORD=your_tms_password
